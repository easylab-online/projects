{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "projects",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-18",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "projects"
    }
  ],
  // Custom domain: projects.easylab.online
  // After first deploy, attach the domain in Cloudflare Dashboard →
  // Workers & Pages → projects → Settings → Domains & Routes
  // or uncomment routes below (zone must be on the same Cloudflare account):
  // "routes": [
  //   { "pattern": "projects.easylab.online/*", "zone_name": "easylab.online" }
  // ],
  "workers_dev": true,
  "preview_urls": true
}
